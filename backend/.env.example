# ==============================================================================
# VICTORY MEDIA DASHBOARD — BACKEND ENVIRONMENT
# ==============================================================================
# Only the variables the five shipped modules actually read are listed here.
# The supporting order/shipment/payment code that carried over with the Sales
# pipeline has its own vars — they stay unset unless you enable those flows.

PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=
# Optional local override used when MONGO_URI is unset.
LOCAL_MONGO_URI=

# ── Authentication (login flow) ──────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=
# Google sign-in (optional — leave blank to disable the Google button).
GOOGLE_CLIENT_ID=

# ── CORS / origins ───────────────────────────────────────────────────────────
ADMIN_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ── SMS: OTP + employee notifications (MSG91) ────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ── Email: leave approvals, task alerts, contact-form leads ──────────────────
# For Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) — the account password will NOT
# work over SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
# Optional friendly sender, e.g. "Victory Media <ops@victorymedia.com>".
MAIL_FROM=
# Second mailbox used to round-robin outbound contact-form replies (optional).
MAIL_USER_1=
MAIL_PASS_1=
# Where website contact-form leads are delivered (comma-separated).
CONTACT_RECIPIENTS=
CONTACT_EMAIL_SUBJECT=
CONTACT_REPLY_TO_ENABLED=true
RETURNS_EMAIL=

# ── Local media storage (avatars, attachments) ───────────────────────────────
# Where uploads are written. Defaults to <Backend>/public/media. Point this
# outside the repo if your deploy pipeline does a fresh clone each time.
UPLOAD_DIR=
# Absolute base prepended to stored URLs. Blank = root-relative (/media/...).
MEDIA_BASE_URL=

# ── Geo-IP (attendance punch location, lead source geography) ────────────────
# `npm run fetch:geoip` downloads GeoLite2-City to data/ using these creds.
# Free signup: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_DB_PATH=
# DEV ONLY: localhost has no public IP. Set a sample public IP to test geo
# locally (e.g. 49.36.0.1 = Mumbai). Leave blank in production.
GEOIP_DEV_FALLBACK_IP=

# ── Shipment (only used by the Sales pipeline's order/tracking views) ────────
# "mock" bypasses all providers — zero external API calls. Recommended here.
SHIPMENT_MODE=mock
